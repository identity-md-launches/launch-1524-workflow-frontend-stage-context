{
  "name": "job-zero-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "node scripts/verify-export.mjs",
    "test": "tsx --test tests/*.test.ts scripts/integrity.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
